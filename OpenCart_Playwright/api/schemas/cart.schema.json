{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cart",
  "type": "object",
  "properties": {
    "id": { "type": "integer" },
    "userId": { "type": "integer" },
    "date": { "type": "string", "format": "date-time" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": { "type": "integer" },
          "quantity": { "type": "integer" }
        },
        "required": ["productId", "quantity"]
      }
    },
    "total": { "type": "number" }
  },
  "required": ["id", "userId", "products"]
}
